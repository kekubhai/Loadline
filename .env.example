# LOADLINE server configuration.
#
# PostgreSQL (Neon) connection string. The workspace API — projects,
# architectures, versions, workloads, simulation runs — is enabled only when
# this is set. Copy this file to `.env` and paste your own Neon connection
# string; never commit a real one.
#
# Expected format (Neon "Connection string" dialog, Go tab):
#   postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require
DATABASE_URL=

# Optional: database used by the persistence tests (`go test ./...` in
# apps/simulator). Use a disposable Neon branch there rather than the database
# the application uses. When unset the tests fall back to DATABASE_URL, and
# when neither is set they skip instead of failing.
LOADLINE_TEST_DATABASE_URL=
