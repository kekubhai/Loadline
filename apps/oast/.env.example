# OAST engine configuration example.
# This file is documentation only; oastd does not load .env files.
# Copy values into your shell or process manager and edit the scopes.

OAST_HTTP_ADDR=127.0.0.1
OAST_HTTP_PORT=8081
OAST_DNS_ADDR=127.0.0.1
OAST_DNS_PORT=5353

OAST_PUBLIC_DOMAIN=oast.local
OAST_CALLBACK_IPV4=127.0.0.1
OAST_CALLBACK_IPV6=::1

# Required. Use only hosts/CIDRs you are authorized to test.
OAST_AUTHORIZED_SCOPES=lab.local,*.apps.lab.test,10.0.0.0/8,192.0.2.10

OAST_MAX_TEST_LIFETIME=1h
OAST_DEFAULT_TEST_TTL=15m
OAST_MAX_ACTIVE_TESTS=100

OAST_MAX_BODY_BYTES=65536
OAST_MAX_HEADER_BYTES=16384
OAST_MAX_QUERY_BYTES=4096
OAST_MAX_EVIDENCE_PER_TEST=500
OAST_MAX_EVIDENCE_BYTES_PER_TEST=1048576

OAST_RATE_LIMIT_PER_SECOND=100
OAST_RATE_LIMIT_BURST=200
